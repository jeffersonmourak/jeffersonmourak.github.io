{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useKeyWithClickEvents": "warn"
      },
      "complexity": {
        "noForEach": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noNodejsModules": "error",
        "noInvalidBuiltinInstantiation": "error"
      },
      "nursery": {},
      "performance": {
        "noAccumulatingSpread": "warn",
        "noDelete": "off"
      },
      "security": {},
      "style": {
        "noNonNullAssertion": "warn",
        "noUselessElse": "off",
        "useCollapsedElseIf": "error",
        "useImportType": "error",
        "noRestrictedImports": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "warn",
        "noConfusingVoidType": "warn",
        "noConsole": "off",
        "noExplicitAny": "warn",
        "noReactSpecificProps": "off",
        "noSkippedTests": "off",
        "noDuplicateElseIf": "error"
      }
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "lineWidth": 240
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "overrides": [
    {
      "includes": [
        "**/packages/circ-terminal/**/*.ts",
        "**/packages/circ-terminal/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    }
  ],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/packages/**/node_modules",
      "!**/.turbo",
      "!**/.yarn",
      "!**/.nyc_output",
      "!**/out",
      "!**/.husky",
      "!yarn.lock",
      "!.yarnrc.yml",
      "!**/deployment",
      "!**/stress-tests",
      "!**/built",
      "!**/build",
      "!**/dist",
      "!**/coverage",
      "!**/scripts"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
